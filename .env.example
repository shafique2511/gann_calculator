# XAUUSD Gann Square of Nine Pro Calculator Setup

# Required for Telegram Integration
# Create a bot via @BotFather to get this token
TELEGRAM_BOT_TOKEN="your_token_here"

# Your Telegram Channel Username (e.g. @mychannel) or Chat ID
TELEGRAM_CHAT_ID="@your_channel"

# Security key used to authorize requests from frontend to backend.
# This must match what you enter in the app settings.
APP_API_KEY="my_secret_key_123"

# Node Environment
NODE_ENV="development"
PORT=3000
